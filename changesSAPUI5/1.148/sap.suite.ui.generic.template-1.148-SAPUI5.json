{
    "1.148.0": {
        "date": "May 2026",
        "notes": [
            {
                "id": "I761cfab7d98cbb1929c9b6a497306cd2f71359a8",
                "type": "FEATURE",
                "text": "You can now enable the save and back feature to allow users to save an object page and navigate back to the list report page"
            },
            {
                "id": "I15181ec264b412aaf5dcb0d304b611161897d314",
                "type": "FIX",
                "text": "We’ve resolved an issue where the analytical list page flickered when users switched between views",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "DINC0698800"
                    }
                ]
            },
            {
                "id": "I2bacd796a2d8107aa3ec62ba3a92fcbb2c22d750",
                "type": "FIX",
                "text": "We've resolved an issue where the Save and Next buttons didn't work on object pages in edit mode",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "DINC0844704"
                    }
                ]
            },
            {
                "id": "Iddeef4a83d97963f5ef53914d3bf84652f9ff365",
                "type": "FIX",
                "text": "The context menu navigation is no longer disabled on list report pages configured with a creationEntitySet setting in the manifest.json file",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "DINC0757466"
                    }
                ]
            },
            {
                "id": "I1e26a1040a6c9433ccf5ac14bc4dca8c829a6d24",
                "type": "FIX",
                "text": "We've resolved an issue where data was not correctly restored on nested object pages when navigating back using the browser back button",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "DINC0469809"
                    }
                ]
            },
            {
                "id": "I9bbe2bfc3e1b06d8fba7f57e3402729b0d5353ec",
                "type": "FIX",
                "text": "We've resolved an issue where export to PDF failed because 1:n navigation properties were incorrectly included in the OData request URL"
            },
            {
                "id": "I9c0344e6184da6a301d1f5ae8aaf8f0d4b8eb169",
                "type": "FIX",
                "text": "We’ve improved the loading speed of the list report page when a record is edited directly from an object page"
            },
            {
                "id": "Iab75f0428c8ceb0fb48ec0238adee22aead036a9",
                "type": "FIX",
                "text": "We've resolved an issue where clicking Edit after a failed save on an object page repeatedly triggered the same error",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "DINC0841209"
                    }
                ]
            },
            {
                "id": "I344bf58c9eadb289cbe9a8e2da227e39bde5dd07",
                "type": "FIX",
                "text": "We've resolved an issue where cross-application navigation using a SmartLink passed empty semantic attribute values as filters after navigating back to a list report from an object page",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "CS20260011771569"
                    }
                ]
            }
        ]
    },
    "1.148.2": {
        "date": "June 2026",
        "notes": [
            {
                "id": "If5aa435ce516996a58b37b94376732eb5282fe23",
                "type": "FIX",
                "text": "We've resolved an issue where error messages from a failed save were lost on sub-object pages, preventing the message popover from showing the backend validation errors",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "DINC0907723"
                    }
                ]
            }
        ]
    },
    "1.148.4": {
        "date": "July 2026",
        "notes": [
            {
                "id": "Ibb409d151206b7cdadf0f6d825464b66b9d3abe4",
                "type": "FIX",
                "text": "We've resolved an issue where custom filter settings weren't applied on the initial load when no previous application state was available",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "DINC0862952"
                    }
                ]
            },
            {
                "id": "I8732847618d36a1f85f74d50e991368dfff4b43b",
                "type": "FIX",
                "text": "We've resolved an issue where 412 (Precondition Failed) warning and error dialogs were not displayed after a failed save action",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "DINC0940573"
                    }
                ]
            },
            {
                "id": "I73b6b67e4a0eea94fb8c3f589efea303d61ef38b",
                "type": "FIX",
                "text": "Cells in grid tables are now correctly hidden when table columns are deactivated",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "DINC0920836"
                    }
                ]
            },
            {
                "id": "I14b8150f0835fa3a23ccea38a458db153a5c3829",
                "type": "FIX",
                "text": "We've resolved an issue where SmartLink navigation landed on the wrong page when composite entity-key fields contained empty string values",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "DINC0932500"
                    }
                ]
            }
        ]
    },
    "1.148.7": {
        "date": "July 2026",
        "notes": [
            {
                "id": "Ia078fe45d1231e647f338f0620a69c13a43215ac",
                "type": "FIX",
                "text": "We've resolved an issue where default filter values in a variant were not restored during the initial loading of the object page when no prior navigation state was available",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "DINC0969078"
                    }
                ]
            },
            {
                "id": "I26f6f26954ac312edbc3e86e62a7c0ff649ff68b",
                "type": "FIX",
                "text": "We now ensure that valid filterable fields are correctly recognised by the AI-assisted easy filter by prioritising the Capabilities.FilterRestrictions annotation over the sap:filterable annotation, aligning with the behavior of the smart filter bar",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "CS20260012941891"
                    }
                ]
            }
        ]
    },
    "1.148.9": {
        "date": "August 2026",
        "notes": [
            {
                "id": "Iab47a625bd4f142d94b8f83b6ab7af05b4018c70",
                "type": "FIX",
                "text": "The discard draft popup is no longer displayed when intent-based navigation links on the object page are opened in a new browser tab or window",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "CS20250010977177"
                    }
                ]
            },
            {
                "id": "I229a9484ec940dfe36bc22ddf6946edee8888f4d",
                "type": "FIX",
                "text": "We've resolved an issue with duplicate cross-app navigation requests that were triggered by rapidly double-clicking an intent-based navigation link",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "CS20250010699200"
                    }
                ]
            }
        ]
    },
    "1.148.10": {
        "date": "September 2026",
        "notes": [
            {
                "id": "I437bb477c976363b78525e9b1d4dc199b12301c7",
                "type": "FIX",
                "text": "We've resolved an issue in the analytical table where clicking a SmartLink inside an expanded row didn't open the popover with navigation links",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "CS20260013063140"
                    }
                ]
            }
        ]
    },
    "1.148.11": {
        "date": "September 2026",
        "notes": [
            {
                "id": "I59c35c1fb89ebf5637eb9c5a23d6ede9fb57786b",
                "type": "FIX",
                "text": "We now ensure that cross-app navigation remains available after the first time the target application opens in a new browser tab",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "DINC1029963"
                    }
                ]
            },
            {
                "id": "I2317ab258ba5f6dd7575eaa00a77a91a4bda6004",
                "type": "FIX",
                "text": "We've resolved an issue where data export failed when a search term was active in the filter bar",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "CS20260013222066"
                    }
                ]
            },
            {
                "id": "I514ecec166a6904ea17ccede5209e908839d1fdc",
                "type": "FIX",
                "text": "We now ensure that row selection on the object page is preserved when navigating to the subobject page in the three-column flexible layout",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "CS20260011574895"
                    }
                ]
            }
        ]
    }
}