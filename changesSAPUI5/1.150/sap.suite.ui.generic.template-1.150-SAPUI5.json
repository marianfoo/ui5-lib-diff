        "notes": [
            {
                "id": "I6450a784733e6bbd11ecd077f55bb498b6b18116",
                "type": "FEATURE",
                "text": "We now support pasting in object page table columns with TextArrangement set to TextOnly"
            },
            {
                "id": "Icfe951cfbfd43dad13282208030afa1c897979bb",
                "type": "FIX",
                "text": "We've resolved an issue where back-end error messages were silently removed before the popover could display them, causing a form reset after a failed save",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "DINC0904534"
                    }
                ]
            },
            {
                "id": "Ic17c504258625b7ae63022760c1542695441747a",
                "type": "FIX",
                "text": "We've resolved an issue where the object page didn't contain the Related Apps button after a key user had enabled it in UI adaptation mode",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "DINC0776618"
                    }
                ]
            },
            {
                "id": "I2317ab258ba5f6dd7575eaa00a77a91a4bda6004",
                "type": "FIX",
                "text": "We've resolved an issue where data export failed when a search term was active in the filter bar",
                "references": [
                    {
                        "type": "SNOW",
                        "reference": "DINC0859508"
                    }
                ]
            },
            {
                "id": "I2d13380303ad3472646444def91e30c31bc727db",
                "type": "FIX",
                "text": "We've resolved an issue where the Visual Filter dialog overflowed at 200% browser zoom, causing focus indicators to overlap filter labels",
                "references": [
